# StayLocal Monorepo Environment Variables Example
# Copy this file to .env (or server/.env and client/.env) to configure local development.

# ==============================================================================
# Backend Server Configuration (server/.env)
# ==============================================================================
# Environment: 'development' | 'production' | 'test'
NODE_ENV=development

# Server port
PORT=5000

# Allowed CORS origins for the frontend client (comma-separated if multiple)
CORS_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# IMPORTANT: Never commit actual database credentials or connection strings to source control.
# If omitted or invalid in development, the server will operate in offline/in-memory mode for development and testing.
MONGODB_URI=

# Optional: Log level ('debug' | 'info' | 'warn' | 'error')
LOG_LEVEL=info

# JWT Authentication Secret & Token Expiration
# In production, use a high-entropy string of at least 32 characters
JWT_SECRET=your-secure-random-jwt-secret-at-least-32-chars-long
JWT_EXPIRES_IN=7d

# ==============================================================================
# Frontend Client Configuration (client/.env)
# ==============================================================================
# Base URL of the backend REST API
VITE_API_BASE_URL=http://localhost:5000/api
